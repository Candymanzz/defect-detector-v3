    "enabled": true,
    "base_url": "http://127.0.0.1:5080",
    "urls": {
      "on": "/api/camera-flash/bank",
      "off": "/api/camera-flash/bank",
      "brightness_pair": "/api/camera-flash/pair",
      "brightness_single": "/api/camera-flash/single",
      "status": "/api/camera-flash/bank"
    },
    "hold_mode": true,
    "timeout_ms": 1500,
    "fail_on_error": false,
    "brightness_percent": 80,
    "duration_ms": 90,
    "flash_lead_ms": 0,
    "settle_delay_ms": 0,
    "interval_flash": {
      "enabled": true,
      "idle_port": 2,
      "start_dark": true
