    "base_url": "http://127.0.0.1:8000",
    "server_concurrency": 10,
    "defer_heatmap": false,
    "defer_learning_review": false,
    "heatmap_preview_max_width": 512,
    "include_visuals": false
  },
  "client": {
    "url": "ws://127.0.0.1:8765",
    "preview_max_fps": 10
  },
  "robot": {
    "url": "http://127.0.0.1:9999",
    "enabled": false
  },
  "fanout": {
    "robot_tcp": {
      "host": "127.0.0.1",
      "port": 9999,
      "connect_timeout_ms": 300,
      "write_timeout_ms": 300,
      "queue_size": 256
    },
    "client_http": {
      "host": "127.0.0.1",
      "port": 8088,
      "queue_size": 128,
      "artificial_delay_ms": 0
    }
  },
  "light_servers": {
    "enabled": true,
    "backend": "native",
    "urls": {
      "on": "/api/camera-flash/bank",
      "off": "/api/camera-flash/bank",
      "brightness_pair": "/api/camera-flash/pair",
      "brightness_single": "/api/camera-flash/single",
      "status": "/api/camera-flash/bank"
    },
    "hold_mode": true,
    "timeout_ms": 1500,
    "fail_on_error": false,
    "brightness_percent": 80,
    "duration_ms": 90,
    "flash_lead_ms": 0,
    "settle_delay_ms": 0,
    "interval_flash": {
      "enabled": true,
      "idle_port": 2,
      "start_dark": true
    }
  },
  "integration": {
    "python_parallelism": 10,
    "python_request_parallelism": 10,
    "python_server_pool_size": 1,
    "stage_queue_size": 20,
    "worker_command_timeout_ms": 30000,
    "worker_startup_stagger_ms": 0,
    "service_command_timeout_ms": 15000,
    "light_server_startup_delay_ms": 0,
    "inspection_cycle_timeout_ms": 3500,
    "inspection_bucket": {
      "enabled": true,
      "mode": "ten_cameras",
      "timeout_ms": 3500,
      "line_broadcast_interval_ms": 3500
    },
    "continuous_inspection": {
      "enabled": false,
      "cycle_delay_ms": 0
    },
    "capture_frame_downscale": {
      "enabled": false,
      "scale": 1.0,
      "apply_to_inspection_capture": true,
      "apply_to_reference_capture": true,
      "apply_to_client_reference_bundle": true
    },
    "analis_surface_autostart": {
      "enabled": true,
      "inspect_workers": 4,
      "working_dir": "cppAnalisSurface",
      "startup_timeout_ms": 30000,
      "health_path": "/health"
    },
    "save_captures": {
      "enabled": false,
      "directory": "testimage",
      "jpeg_quality": 0.92
    },
    "analis_surface_command_linux": [
      "cppAnalisSurface/build/cpp_analis_surface",
      "--host",
      "127.0.0.1",
      "--port",
      "8000",
      "--data-dir",
      "data"
    ],
    "performance_log": {
      "enabled": true,
      "directory": "logs/performance",
      "queue_capacity": 8192
    }
