    "light_server_startup_delay_ms": 0,
    "inspection_cycle_timeout_ms": 3500,
    "inspection_bucket": {
      "enabled": true,
      "phases": [
        {
          "id": 0,
          "groups": [
            { "id": 0, "camera_ids": [0, 1, 2, 3, 4] },
            { "id": 1, "camera_ids": [5, 6, 7, 8, 9] }
