      },
      "udp": {
        "enabled": true,
        "bind_host": "0.0.0.0",
        "bind_port": 9100,
        "format": "io_input",
        "debounce_ms": 0
      },
      "io_input": {
        "work_port": 1,
        "direction_port": 2,
        "trigger_port": 3,
        "shutdown_port": 4,
        "direction_latch_on_work": false,
        "di3_only": true,
        "repeat_di3_capture": true,
        "direction_latch": false,
        "capture_delay_ms": 0,
        "trigger_edge": "rising",
        "payload_format": "json",
        "debounce_ms": 0,
        "require_direction": true,
        "require_work": false,
        "external_hardware_capture": true,
        "direction_poll_ms": 1
      }
    },
    "continuous_inspection": {
      "enabled": false,
      "cycle_delay_ms": 3500
    },
    "capture_frame_downscale": {
      "enabled": false,
      "scale": 1.0,
