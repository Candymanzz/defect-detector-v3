{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SerialLight": {
    "EnumPorts": [ "COM1", "COM3" ],
    "KeepDeviceOpen": true,
    "EnumCacheSeconds": 300,
    "PreconfigureBrightnessOnOpen": true,
    "FlashSyncMode": "Hold",
    "DisableSdkLock": true
  },
  "IoController": {
    "BrightnessMapping": "Scale255To100",
    "FlashMode": "Hold",
    "DefaultDurationMs": 500,
    "KeepComSessionOpen": false
  }
}
