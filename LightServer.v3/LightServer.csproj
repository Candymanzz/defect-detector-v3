<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LightServer</RootNamespace>
    <AssemblyName>LightServer</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- SDK: LightServer.v3/ThirdParty/MVS/ (DotNet + Runtime/win64). Fallback: MVS_ROOT / установленный MVS Client -->
    <_MvsDefaultRoot>C:\Program Files (x86)\MVS</_MvsDefaultRoot>
    <_MvsAltRoot>E:\MVS</_MvsAltRoot>
    <MvsInstallDir Condition="'$(MVS_ROOT)' != ''">$(MVS_ROOT)</MvsInstallDir>
    <MvsInstallDir Condition="'$(MvsInstallDir)' == '' and Exists('$(_MvsDefaultRoot)\Development')">$(_MvsDefaultRoot)</MvsInstallDir>
    <MvsInstallDir Condition="'$(MvsInstallDir)' == '' and Exists('$(_MvsAltRoot)\Development')">$(_MvsAltRoot)</MvsInstallDir>
    <MvCameraControlNetDll Condition="Exists('$(MSBuildProjectDirectory)\..\Test\ThirdParty\MVS\DotNet\MvCameraControl.Net.dll')">$(MSBuildProjectDirectory)\..\Test\ThirdParty\MVS\DotNet\MvCameraControl.Net.dll</MvCameraControlNetDll>
    <MvCameraControlNetDll Condition="'$(MvCameraControlNetDll)' == '' and Exists('$(MSBuildProjectDirectory)\ThirdParty\MVS\DotNet\MvCameraControl.Net.dll')">$(MSBuildProjectDirectory)\ThirdParty\MVS\DotNet\MvCameraControl.Net.dll</MvCameraControlNetDll>
    <MvCameraControlNetDll Condition="'$(MvCameraControlNetDll)' == '' and Exists('$(MvsInstallDir)\Development\DotNet\win64\netstandard2.0\MvCameraControl.Net.dll')">$(MvsInstallDir)\Development\DotNet\win64\netstandard2.0\MvCameraControl.Net.dll</MvCameraControlNetDll>
    <MvCameraControlNetDll Condition="'$(MvCameraControlNetDll)' == '' and Exists('$(MvsInstallDir)\Development\DotNet\win64\net40\MvCameraControl.Net.dll')">$(MvsInstallDir)\Development\DotNet\win64\net40\MvCameraControl.Net.dll</MvCameraControlNetDll>
    <MvCameraControlNetDll Condition="'$(MvCameraControlNetDll)' == '' and Exists('$(MvsInstallDir)\Development\DotNet\AnyCpu\netstandard2.0\MvCameraControl.Net.dll')">$(MvsInstallDir)\Development\DotNet\AnyCpu\netstandard2.0\MvCameraControl.Net.dll</MvCameraControlNetDll>
    <MvCameraControlNetDll Condition="'$(MvCameraControlNetDll)' == '' and Exists('$(MvsInstallDir)\Development\DotNet\AnyCpu\net40\MvCameraControl.Net.dll')">$(MvsInstallDir)\Development\DotNet\AnyCpu\net40\MvCameraControl.Net.dll</MvCameraControlNetDll>
    <MvsRuntimeDir Condition="Exists('$(MSBuildProjectDirectory)\..\Test\ThirdParty\MVS\Runtime\win64')">$(MSBuildProjectDirectory)\..\Test\ThirdParty\MVS\Runtime\win64</MvsRuntimeDir>
    <MvsRuntimeDir Condition="'$(MvsRuntimeDir)' == '' and Exists('$(MSBuildProjectDirectory)\ThirdParty\MVS\Runtime\win64')">$(MSBuildProjectDirectory)\ThirdParty\MVS\Runtime\win64</MvsRuntimeDir>
    <MvsRuntimeDir Condition="'$(MvsRuntimeDir)' == '' and Exists('$(_MvsDefaultRoot)\Applications\Win64')">$(_MvsDefaultRoot)\Applications\Win64</MvsRuntimeDir>
    <MvsRuntimeDir Condition="'$(MvsRuntimeDir)' == '' and Exists('$(MvsInstallDir)\Applications\Win64')">$(MvsInstallDir)\Applications\Win64</MvsRuntimeDir>
    <MvIoRuntimeDir Condition="Exists('$(MSBuildProjectDirectory)\ThirdParty\MVS\IO\win64')">$(MSBuildProjectDirectory)\ThirdParty\MVS\IO\win64</MvIoRuntimeDir>
    <MvIoRuntimeDir Condition="'$(MvIoRuntimeDir)' == ''">C:\Program Files (x86)\MV_VC_VB_VT_IO_SDK_V2.0.0.3_Repair_Build240620\Demo\C#\win64</MvIoRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageReference Include="System.IO.Ports" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MvCameraControlNetDll)')">
    <Reference Include="MvCameraControl.Net">
      <HintPath>$(MvCameraControlNetDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateMvsReference" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MvCameraControlNetDll)')"
           Text="MvCameraControl.Net.dll not found. Place SDK files in LightServer.v3/ThirdParty/MVS/DotNet/ or install MVS and set MVS_ROOT." />
  </Target>

  <ItemGroup Condition="Exists('$(MvsRuntimeDir)')">
    <Content Include="$(MvsRuntimeDir)\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MvIoRuntimeDir)\MvIOInterfaceBox.dll')">
    <Content Include="$(MvIoRuntimeDir)\MvIOInterfaceBox.dll">
      <Link>MvIOInterfaceBox.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
