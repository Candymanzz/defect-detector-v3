{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SerialLight": {
    "EnumPorts": [ "COM1", "COM3" ]
  },
  "IoController": {
    "BrightnessMapping": "Scale255To100",
    "FlashMode": "Trigger",
    "DefaultDurationMs": 180,
    "KeepComSessionOpen": true
  }
}
