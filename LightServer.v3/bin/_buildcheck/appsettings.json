{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ComLightDevices": {
    "InitializeOnStartup": true,
    "Devices": [
      { "ComPort": "COM1", "Channels": [ 1, 2 ] },
      { "ComPort": "COM2", "Channels": [ 1, 2, 3, 4 ] }
    ]
  },
  "SerialLight": {
    "EnumPorts": [ "COM1", "COM2" ],
    "KeepDeviceOpen": true,
    "EnumCacheSeconds": 300,
    "PreconfigureBrightnessOnOpen": true,
    "FlashSyncMode": "Direct",
    "BankFlashSyncMode": "Hold",
    "PrearmBankOnInit": false,
    "SustainOnAfterTrigger": true,
    "DisableSdkLock": false
  },
  "IoController": {
    "BrightnessMapping": "Scale255To100",
    "FlashMode": "Hold",
    "DefaultDurationMs": 500,
    "KeepComSessionOpen": false
  }
}
